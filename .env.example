# Avalanche C-Chain RPC Endpoints
VITE_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
VITE_AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployed DevGraveyard Smart Contract Address (leave empty to use local fallback mode)
VITE_CONTRACT_ADDRESS=

# Target Chain ID (43114 for Avalanche C-Chain Mainnet, 43113 for Fuji Testnet)
VITE_CHAIN_ID=43114

# WalletConnect Cloud Project ID (Optional - get one from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Gemini API Key (Optional - client fallback heuristic handles post-mortems if not set)
VITE_GEMINI_API_KEY=
